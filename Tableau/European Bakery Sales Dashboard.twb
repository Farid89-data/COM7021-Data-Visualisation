        <calculation class='tableau' formula='(WINDOW_SUM([Current Profit (copy)_1851636310167595]) - WINDOW_SUM([Previous Year Profit (copy)_1851636309848105]))&#13;&#10;/&#13;&#10;(WINDOW_SUM([Previous Year Profit (copy)_1851636309848105]))'>
