      <column caption='Total_Revenue' datatype='real' name='[Calculation_1851636286349337]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Revenue(£)])' />
      </column>
      <column caption='KPI_Revenue' datatype='string' name='[Calculation_1851636288458778]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;£&quot; + STR(ROUND(SUM([Revenue(£)]) / 1000, 0)) + &quot;K&quot;' />
      </column>
      <column caption='Current Profit' datatype='real' name='[Calculation_1851636303294496]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if LAST()=0 then sum([Profit(£)]) END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Previous Year Profit' datatype='real' name='[Calculation_1851636303634465]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if LAST()= 1 THEN SUM([Profit(£)]) END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Diffrence Profit (%)' datatype='real' default-format='p0%' name='[Calculation_1851636304707620]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(WINDOW_SUM([Calculation_1851636303294496]) - WINDOW_SUM([Calculation_1851636303634465]))&#13;&#10;/&#13;&#10;(WINDOW_SUM([Calculation_1851636303634465]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
