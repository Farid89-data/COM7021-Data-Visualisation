        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='18' underline='true'>&lt;Sheet Name&gt;</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontsize='10'>Current Revenue:</run>
            <run fontalignment='1' fontsize='10'><![CDATA[ <[federated.1wow9lc0nxdrt11b1vh2u013xzdd].[usr:Current Profit (copy)_1851636310167595:qk:1]> ]]></run>
            <run bold='true' fontalignment='1' fontsize='10'>£</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontsize='10'><![CDATA[<[federated.1wow9lc0nxdrt11b1vh2u013xzdd].[usr:Diffrence Profit (%) (copy)_1851636310011946:qk:1]> ]]></run>
            <run bold='true' fontalignment='1' fontsize='10'>VS</run>
            <run fontalignment='1' fontsize='10'><![CDATA[ <[federated.1wow9lc0nxdrt11b1vh2u013xzdd].[usr:Previous Year Profit (copy)_1851636309848105:qk:1]> £]]></run>
            <run fontalignment='1'>Æ&#10;</run>
            <run bold='true' fontalignment='1' fontsize='10'>Total Revenue(</run>
            <run fontalignment='1' fontsize='10'>£</run>
            <run bold='true' fontalignment='1' fontsize='10'>):</run>
            <run fontalignment='1' fontsize='10'><![CDATA[<[federated.1wow9lc0nxdrt11b1vh2u013xzdd].[sum:Revenue(£):qk]>]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='bakery_cleaned' name='federated.1wow9lc0nxdrt11b1vh2u013xzdd' />
          </datasources>
          <datasource-dependencies datasource='federated.1wow9lc0nxdrt11b1vh2u013xzdd'>
            <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
            <column caption='Current Revenue' datatype='real' name='[Current Profit (copy)_1851636310167595]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if LAST()=0 then sum([Revenue(£)]) END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='date' name='[Date]' role='dimension' type='ordinal' />
            <column caption='Diffrence Revenue (%)' datatype='real' default-format='p0%' name='[Diffrence Profit (%) (copy)_1851636310011946]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(WINDOW_SUM([Current Profit (copy)_1851636310167595]) - WINDOW_SUM([Previous Year Profit (copy)_1851636309848105]))&#13;&#10;/&#13;&#10;(WINDOW_SUM([Previous Year Profit (copy)_1851636309848105]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Previous Year Revenue' datatype='real' name='[Previous Year Profit (copy)_1851636309848105]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if LAST()= 1 THEN SUM([Revenue(£)]) END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='real' name='[Revenue(£)]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Year]' role='dimension' type='quantitative' />
            <column-instance column='[Year]' derivation='None' name='[none:Year:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Revenue(£)]' derivation='Sum' name='[sum:Revenue(£):qk]' pivot='key' type='quantitative' />
            <column-instance column='[Current Profit (copy)_1851636310167595]' derivation='User' name='[usr:Current Profit (copy)_1851636310167595:qk:1]' pivot='key' type='quantitative'>
              <table-calc ordering-field='[federated.1wow9lc0nxdrt11b1vh2u013xzdd].[yr:Date:ok]' ordering-type='Field' />
            </column-instance>
            <column-instance column='[Diffrence Profit (%) (copy)_1851636310011946]' derivation='User' name='[usr:Diffrence Profit (%) (copy)_1851636310011946:qk:1]' pivot='key' type='quantitative'>
              <table-calc ordering-field='[federated.1wow9lc0nxdrt11b1vh2u013xzdd].[yr:Date:ok]' ordering-type='Field' />
              <table-calc field='[federated.1wow9lc0nxdrt11b1vh2u013xzdd].[Current Profit (copy)_1851636310167595]' ordering-type='Rows' />
              <table-calc field='[federated.1wow9lc0nxdrt11b1vh2u013xzdd].[Previous Year Profit (copy)_1851636309848105]' ordering-type='Rows' />
